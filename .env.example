# ── Required ──────────────────────────────────────────────
ORIGIN=AAA
DESTINATION=BBB
DEPART_DATE=2099-01-01
# Leave empty for a one-way trip
RETURN_DATE=2099-01-15
TELEGRAM_BOT_TOKEN=000000000:replace-with-your-bot-token
TELEGRAM_CHAT_ID=000000000

# ── Optional ──────────────────────────────────────────────
PASSENGERS=1
# economy | premium-economy | business | first
CABIN_CLASS=economy
CURRENCY=USD
# Per passenger: with PASSENGERS=3, PRICE_FLOOR=850 alerts below 2550 total.
# Empty disables the corresponding alert
PRICE_FLOOR=
PRICE_CEILING=
CHANGE_THRESHOLD_PCT=5
# Comma-separated YYYY-MM-DD dates
REMINDER_DATES=
DEADLINE_DATE=
# Local times (per TZ), comma-separated HH:MM
SCRAPE_TIMES=09:00,21:00
TZ=UTC
# Empty = dashboard is public. Set a long random string to require ?token=...
DASHBOARD_TOKEN=
